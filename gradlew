##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh does
#       not find it on the system, try /usr/xpg4/bin/sh -x to trace the issue.
#
#   (2) Be very careful when you add / remove services to this script as it has
#       quite a few shell metacharacters in it which could cause an "unmatched
#       quote" syntax error.
#
##############################################################################

as_fn_mkdir_p()
{
  case $1 in #(
  -*) as_dir=./$1;;
  *) as_dir=$1;;
  esac
  test -d "$as_dir" || mkdir -p "$as_dir" || as_fn_error $? "cannot create directory $as_dir"
}


as_fn_error()
{
  as_status=$1; test $as_status -eq 0 && as_status=1
  if test "$3"; then
    as_lineno=${as_lineno-"$2"} as_fn_error_nl="
"
  else
    as_lineno=${as_lineno-"$2"} as_fn_error_nl=
  fi
  eval 'test "x$as_status" = x0 || exit 1'
} # as_fn_error


as_fn_ret_success()
{
  return 0
}

as_fn_ret_failure()
{
  return 1
}

as_fn_success()
{
  as_fn_return 0
}

as_fn_failure()
{
  as_fn_return 1
}

as_fn_ret_failure $? && { exitcode=1; break; }

as_fn_set_status()
{
  return $1
} # as_fn_set_status

as_fn_exit()
{
  set +e
  as_fn_set_status $1
  exit $1
} # as_fn_exit

if expr a : '\(a\)' >/dev/null 2>&1 &&
   test "X`expr 00001 : '.*\(...\)'`" = X001; then
  as_expr=expr
else
  as_expr=false
fi

if (basename -- /) >/dev/null 2>&1 && test "X`basename -- / 2>&1`" = "X/"; then
  as_basename=basename
else
  as_basename=false
fi

if (as_fn_mkdir_p) 2>/dev/null; then
  as_mkdir_p='as_fn_mkdir_p'
else
  as_mkdir_p=false
fi

as_test_x='test -x'
as_executable_p=as_fn_success

umask 77


if test -n "${ZSH_VERSION+set}" ; then
  setopt NO_GLOB_SUBST
fi

case `uname` in #(
  *CYGWIN*) as_fn_error $? "Cygwin not supported" "$LINENO" 5 ;;
esac

case `uname` in #(
  Linux* | GNU* | *-musl*) ;;
  Darwin* ) as_fn_error $? "Bash on macOS is not supported" "$LINENO" 5 ;;
  MINGW* ) as_fn_error $? "MinGw not supported" "$LINENO" 5 ;;
esac

CDPATH=

as_fn_mkdir_p "$DIRNAME"

# Find the absolute filename.
as_fn_cwd_restore() { cd "$as_cwd"; }

cd "$DIRNAME"

as_cwd=$(pwd -L) && as_pwd=$(pwd -P)

APP_HOME=$as_pwd
APP_BASE_NAME=`basename "$0"`
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Execute Gradle
exec "$JAVACMD" $DEFAULT_JVM_OPTS \
  -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" \
  org.gradle.wrapper.GradleWrapperMain \
  "$@"

